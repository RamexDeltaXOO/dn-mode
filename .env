# ── Database ───────────────────────────────────────────────────
DATABASE_URL=mysql://root:]Q39/dyR<d=|Ui`h@34.155.118.58:3306/dn-mode              # MySQL connection string (mysql://user:pass@host:port/db)

# ────────────────────────────────────────────────────────────────
# Les cles ci-dessous sont OPTIONNELLES ici : elles sont surtout
# destinees a etre saisies depuis le CRM (Admin > Parametres), qui
# les stocke dans la table `site_config`. Les variables
# d'environnement ne servent que de valeur de repli.
# ────────────────────────────────────────────────────────────────

# ── Public URL ──────────────────────────────────────────────────
PUBLIC_APP_URL=https://dn-mode.com           # URL publique de la boutique (https://dnmode.fr), utilisee dans les emails

# ── Paiement (Stripe) ───────────────────────────────────────────
STRIPE_SECRET_KEY=        # sk_live_... / sk_test_...  (config: stripe_secret_key)
                          # La cle publique se saisit dans le CRM (config: stripe_publishable_key)

# ── Livraison (Sendcloud : Colissimo / Chronopost / Mondial Relay) ─
SENDCLOUD_PUBLIC_KEY=     # Cle publique API Sendcloud (config: sendcloud_public_key)
SENDCLOUD_SECRET_KEY=     # Cle secrete API Sendcloud (config: sendcloud_secret_key)
SENDCLOUD_SENDER_ADDRESS_ID=  # ID de l'adresse d'expedition Sendcloud (config: sendcloud_sender_address_id)
SENDCLOUD_DEFAULT_WEIGHT=     # Poids par defaut d'un colis en kg, ex: 1 (config: sendcloud_default_weight)

# ── Connexion Gmail (Google OAuth 2.0) ──────────────────────────
GOOGLE_CLIENT_ID=         # xxx.apps.googleusercontent.com  (config: gmail_client_id)
GOOGLE_CLIENT_SECRET=     # GOCSPX-...                      (config: gmail_client_secret)
                          # URI de redirection a declarer dans Google Cloud :
                          #   https://<votre-domaine>/api/auth/google/callback

# ── Emails transactionnels (Resend) ─────────────────────────────
RESEND_API_KEY=           # re_...                (config: resend_api_key)
FROM_EMAIL=               # DN MODE <contact@dnmode.fr>  (config: from_email)
SUPPORT_EMAIL=            # sav@dnmode.fr         (config: support_email)
